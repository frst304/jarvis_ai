# Copiez ce fichier en ".env" puis renseignez votre cle API Anthropic.
# Cle a creer sur https://platform.claude.com (rubrique API Keys).
# Sans cle, JARVIS fonctionne en "mode autonome" (commandes de base, sans IA).
ANTHROPIC_API_KEY=

# Port de l'interface (http://127.0.0.1:8777)
JARVIS_PORT=8777

# Dossier des donnees (notes, memoire, rappels...). Par defaut: ./data
# JARVIS_DATA_DIR=
